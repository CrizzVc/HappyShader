# Happy Shaders - Traducción al Español

# Menús
screen.CEL_SHADING_MENU=Iluminación Cel-Shading (Toon)
screen.CEL_SHADING_MENU.comment=Ajustes de sombras escalonadas e iluminación estilo dibujo animado.
screen.WAVING_MENU=Movimiento por Viento
screen.WAVING_MENU.comment=Animaciones de viento en plantas, flores y hojas de árboles.
screen.WATER_MENU=Agua Estilizada
screen.WATER_MENU.comment=Configuración de color, transparencia y ondas del agua.

# Opciones Cel-Shading
option.CEL_SHADING=Iluminación Toon
option.CEL_SHADING.comment=Activa la iluminación estilizada por bandas en bloques y entidades.
option.CEL_BANDS=Bandas de Luz
option.CEL_BANDS.comment=Número de escalones de sombra y luz solar directa.
option.CEL_SHADOW_BRIGHTNESS=Brillo de Sombras
option.CEL_SHADOW_BRIGHTNESS.comment=Intensidad de la luz ambiental en zonas sombreadas.
option.CEL_TORCH_STEPS=Escalones de Antorchas
option.CEL_TORCH_STEPS.comment=Niveles de luz artificial de antorchas y fuentes de luz.
option.WARM_LIGHTING=Iluminación Cálida
option.WARM_LIGHTING.comment=Tonos dorados y acogedores para el sol y las antorchas.

# Opciones Viento
option.WAVING_FOLIAGE=Mover Vegetación
option.WAVING_FOLIAGE.comment=Animación de viento suave en hierba, flores y cultivos.
option.WAVING_LEAVES=Mover Hojas
option.WAVING_LEAVES.comment=Suave susurro del viento en las hojas de los árboles.
option.WAVING_SPEED=Velocidad del Viento
option.WAVING_SPEED.comment=Velocidad a la que oscilan las plantas y hojas.
option.WAVING_INTENSITY=Fuerza del Viento
option.WAVING_INTENSITY.comment=Amplitud de movimiento al mecerse la vegetación.

# Opciones Agua
option.CARTOON_WATER=Agua Cartoon
option.CARTOON_WATER.comment=Agua limpia, vibrante y estilizada con destellos y olas.
option.WATER_WAVE_DISPLACEMENT=Ondulación del Agua
option.WATER_WAVE_DISPLACEMENT.comment=Deformación geométrica suave en la superficie del agua.
option.WATER_RIPPLES=Destellos de Agua
option.WATER_RIPPLES.comment=Líneas animadas de espuma y reflejos en el agua.
option.WATER_STYLE=Estilo de Color
option.WATER_STYLE.comment=Paleta cromática del agua: 0=Turquesa Tropical, 1=Azul Cielo, 2=Laguna Esmeralda.
value.WATER_STYLE.0=Turquesa Tropical
value.WATER_STYLE.1=Azul Cielo
value.WATER_STYLE.2=Laguna Esmeralda
option.WATER_TRANSPARENCY=Transparencia del Agua
option.WATER_TRANSPARENCY.comment=Claridad del agua para ver el fondo submarino.

# Menú Sombras Dinámicas
screen.SHADOW_MENU=Sombras Dinámicas
screen.SHADOW_MENU.comment=Sombras proyectadas en tiempo real desde el sol y la luna.

# Opciones Sombras
option.DYNAMIC_SHADOWS=Sombras Dinámicas
option.DYNAMIC_SHADOWS.comment=Activa las sombras proyectadas en tiempo real por el sol/luna.
option.SHADOW_MAP_RESOLUTION=Resolución del Mapa
option.SHADOW_MAP_RESOLUTION.comment=Resolución del mapa de sombras en píxeles. Valores altos = más detalle y más coste en FPS.
option.SHADOW_QUALITY=Calidad de Filtro
option.SHADOW_QUALITY.comment=Tipo de suavizado en los bordes de las sombras. 0=Duro, 1=Suave (4-tap), 2=Ultra (12-tap).
value.SHADOW_QUALITY.0=Duro
value.SHADOW_QUALITY.1=Suave (PCF 4x)
value.SHADOW_QUALITY.2=Ultra (PCF 12x)
option.SHADOW_DISTANCE=Distancia de Sombras
option.SHADOW_DISTANCE.comment=Distancia de renderizado de sombras en chunks. Mayor = más lejos pero más costoso.
option.SHADOW_BIAS=Sesgo de Profundidad
option.SHADOW_BIAS.comment=Ajuste para evitar artefactos (acné de sombras). Aumentar si se ven líneas extrañas.
option.SHADOW_DISTORTION=Distorsión del Mapa
option.SHADOW_DISTORTION.comment=Concentra el detalle de sombras cerca del jugador. Mayor = más detalle cercano.
option.SHADOW_DARKNESS=Oscuridad de las Sombras
option.SHADOW_DARKNESS.comment=Qué tan oscuras son las zonas sombreadas. 0=Sombras negras, valores altos=más claras.

# Opciones Generales
option.CARTOON_VIBRANCE=Vibración de Color
option.CARTOON_VIBRANCE.comment=Intensidad y viveza de los colores del mundo.
option.CARTOON_CONTRAST=Contraste
option.CARTOON_CONTRAST.comment=Curva de contraste estilo cómic.
option.STYLIZED_SKY=Cielo Estilizado
option.STYLIZED_SKY.comment=Degradados de cielo cartoon para día, atardecer y noche.
option.STYLIZED_CLOUDS=Nubes Cartoon
option.STYLIZED_CLOUDS.comment=Nubes esponjosas con iluminación acorde a la hora del día.
